rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return isSignedIn() && hasUserDoc() && getUserDoc().role == role;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'ismailehossenhira@gmail.com' || 
          request.auth.token.email.lower() == 'admin@fleetflow.local'
        )) ||
        hasRole('Admin')
      );
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'ismailehossenhira@gmail.com' || 
          request.auth.token.email.lower() == 'admin@fleetflow.local'
        )) ||
        hasRole('Admin')
      ); 
    }

    function isSubAdmin() { return hasRole('Sub Admin'); }
    function isOCC() { return hasRole('OCC'); }
    function isLineSupervisor() { return hasRole('Line Supervisor'); }
    function isChecker() { return hasRole('Checker'); }

    function hasPermission(moduleKey) {
      return isSignedIn() && (
        isAdmin() || 
        (hasUserDoc() && (
          getUserDoc().get('allPermissions', false) == true ||
          moduleKey in getUserDoc().get('permissions', [])
        ))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth.uid == userId);
      allow update: if isSuperAdmin() 
        || isAdmin()
        || (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isSuspended', 'permissions', 'allPermissions']));
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // System Check
    match /system/{docId} {
      allow read: if isSignedIn();
    }

    // Vehicle Validation
    function isValidVehicle(data) {
      return data.keys().hasAll(['vehicleNumber', 'type', 'status'])
        && data.vehicleNumber is string && data.vehicleNumber.size() > 0 && data.vehicleNumber.size() <= 64
        && data.type is string && data.type.size() > 0 && data.type.size() <= 64
        && data.status in ['Available', 'On Trip', 'Maintenance', 'Pending Out Scan'];
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      // Adding new vehicles and deleting
      allow create: if (isAdmin() || isSubAdmin()) && isValidVehicle(incoming());
      allow update: if isSignedIn() && (
        // Action: Status Update (during Trip start/end, Maintenance, or making Available)
        (incoming().diff(existing()).affectedKeys().hasAny(['status', 'updatedAt', 'updatedBy', 'maintenanceNotes', 'warehouse', 'previousWarehouse', 'transferredAt', 'tools', 'documents'])) ||
        // Action: Full Update by Admin or Sub Admin
        ((isAdmin() || isSubAdmin()) && isValidVehicle(incoming()))
      );
      allow delete: if isAdmin();
    }

    // Driver/Staff Validation
    function isValidDriver(data) {
      return data.keys().hasAll(['driverId', 'name', 'phoneNumber'])
        && data.driverId is string && data.driverId.size() > 0
        && data.name is string && data.name.size() > 0
        && data.phoneNumber is string;
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSubAdmin();
      allow update: if isAdmin() || isSubAdmin() || (
        isSignedIn() && incoming().diff(existing()).affectedKeys().hasAny(['warehouse', 'previousWarehouse', 'transferredAt', 'updatedAt', 'updatedBy', 'isSuspended', 'suspensionEndDate', 'suspensionReason', 'suspendedBy', 'suspensionDays'])
      );
      allow delete: if isAdmin();
    }

    // Trip Validation
    function isValidTrip(data) {
      return data.keys().hasAll(['vehicleId', 'driverId', 'driverName', 'location', 'status'])
        && data.vehicleId is string
        && data.driverId is string
        && data.driverName is string
        && data.location is string
        && data.status in ['Pending', 'Running', 'Completed', 'Cancelled'];
    }

    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || hasPermission('new_trip') || hasPermission('trips') || isSubAdmin() || isLineSupervisor();
      allow update: if isSignedIn() && (
        // Action: Complete/Cancel Trip (Status change, return inspection, or cancellation)
        (incoming().diff(existing()).affectedKeys().hasAny(['status', 'endTime', 'startTime', 'startedBy', 'completedBy', 'cancelledBy', 'cancelReason', 'inspectionOnReturn', 'updatedAt', 'updatedBy'])) ||
        // Action: Assign Case
        (incoming().diff(existing()).affectedKeys().hasOnly(['caseDetails'])) ||
        // Action: Generic Update
        isAdmin() || hasPermission('trips') || isSubAdmin() || isLineSupervisor()
      );
      allow delete: if isAdmin() || isSubAdmin() || hasPermission('trips');
    }

    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || hasPermission('cases');
      allow delete: if isAdmin();
    }

    // Missing Reports Validation
    function isValidMissingReport(data) {
      return data.keys().hasAll(['tripId', 'vehiclePlate', 'driverId', 'driverName', 'status'])
        && data.tripId is string
        && data.vehiclePlate is string
        && data.driverId is string
        && data.driverName is string
        && data.status in ['Pending', 'Resolved'];
    }

    // Vehicle Status Log Validation
    function isValidVehicleStatusLog(data) {
      return data.keys().hasAll(['vehicleId', 'vehiclePlate', 'oldStatus', 'newStatus'])
        && data.vehicleId is string && data.vehicleId.size() > 0
        && data.vehiclePlate is string && data.vehiclePlate.size() > 0
        && data.oldStatus is string
        && data.newStatus is string;
    }

    // Morning Prep Validation
    function isValidMorningPrep(data) {
      return data.keys().hasAll(['vehicleId', 'vehiclePlate', 'driverId', 'driverName', 'overallStatus'])
        && data.vehicleId is string && data.vehicleId.size() > 0
        && data.vehiclePlate is string && data.vehiclePlate.size() > 0
        && data.driverId is string && data.driverId.size() > 0
        && data.driverName is string && data.driverName.size() > 0
        && data.overallStatus in ['Ready', 'Requires Maintenance'];
    }

    match /missing_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMissingReport(incoming());
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /missing_reports_history/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /vehicle_status_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVehicleStatusLog(incoming());
      allow update, delete: if false;
    }

    // Staff Notes Validation (Immutable Rating & Remarks History)
    function isValidStaffNote(data) {
      return data.keys().hasAll(['staffId', 'staffName', 'authorName', 'authorRole', 'noteText'])
        && data.staffId is string && data.staffId.size() > 0
        && data.staffName is string && data.staffName.size() > 0
        && data.authorName is string && data.authorName.size() > 0
        && data.authorRole is string && data.authorRole.size() > 0
        && data.noteText is string && data.noteText.size() > 0;
    }

    match /morning_preps/{prepId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMorningPrep(incoming());
      allow update: if isAdmin() || hasPermission('morning_prep');
      allow delete: if isAdmin();
    }

    match /maintenance/{maintenanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /staff_notes/{noteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStaffNote(incoming());
      allow update, delete: if false;
    }

    // GPS & Camera Devices (ADL & BD Tracking)
    function isValidGPSDevice(data) {
      return data.keys().hasAll(['vehiclePlate', 'provider'])
        && data.vehiclePlate is string && data.vehiclePlate.size() > 0
        && data.provider in ['ADL', 'BD Tracking'];
    }

    match /gps_devices/{deviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidGPSDevice(incoming());
      allow delete: if isAdmin();
    }

    // Vehicle Models (Managed exclusively by Admins & Super Admins)
    function isValidVehicleModel(data) {
      return data.keys().hasAll(['name'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    match /vehicle_models/{modelId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidVehicleModel(incoming());
      allow update: if isAdmin() && isValidVehicleModel(incoming());
      allow delete: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
